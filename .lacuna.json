{
  "$schema": "https://raw.githubusercontent.com/Octagon-simon/lacuna/main/lacuna.schema.json",
  "testRunner": "pytest",
  "sourceDir": "collatz",
  "testDir": "tests",
  "coverageFormat": "lcov",
  "coverageDir": "coverage",
  "threshold": 90,
  "coverageTimeout": 600,
  "testEnv": {
    "PYTEST_ADDOPTS": "--cov=collatz --cov-branch --cov-report=lcov:coverage/lcov.info --cov-report=json:coverage/coverage.json --cov-report=term-missing"
  }
}
